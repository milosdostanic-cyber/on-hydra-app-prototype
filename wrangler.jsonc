{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "on-hydra-app-prototype",
  "compatibility_date": "2026-09-11",
  "main": "workers/auth.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
