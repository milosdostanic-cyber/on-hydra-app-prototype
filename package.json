{
  "name": "bom",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "tokens:dump": "node scripts/dump-primary-tokens.mjs",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:unit:catalog-bom": "npx --yes tsx -e \"import { runCatalogBomAddTests } from './src/search/catalogBomAdd.test.ts'; console.log('ok', runCatalogBomAddTests());\""
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "antd": "^6.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@storybook/react-vite": "10.6.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.61.0",
    "storybook": "10.6.2",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "wrangler": "^4.131.0"
  }
}
